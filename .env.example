# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# The name of the channel the bot should monitor (e.g. poke-counter)
CHANNEL_NAME=poke-counter

# Optional: Specific Channel ID to monitor (takes precedence over CHANNEL_NAME if provided)
# CHANNEL_ID=123456789012345678

# Starting count number when resetting or starting fresh (default: 10)
STARTING_CP=10

# Allow the same user to post consecutive counts (true/false, default: true)
ALLOW_CONSECUTIVE_COUNTS=true

# Custom path to tesseract binary if not in PATH (e.g. /usr/bin/tesseract or /opt/homebrew/bin/tesseract)
# TESSERACT_CMD=/usr/bin/tesseract
